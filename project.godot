; Standalone authoring tool. The separate game and private art are not imported.
config_version=5

[application]
config/name="Hughes Atlas — development library"
run/main_scene="res://addons/hughes_atlas/atlas.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1600
window/size/viewport_height=960
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"

[editor_plugins]
enabled=PackedStringArray("res://addons/hughes_atlas/plugin.cfg")

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
